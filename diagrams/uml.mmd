classDiagram
    class Owner {
        +str name
        +int available_minutes
        +time day_start
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet) None
        +remove_pet(pet) None
        +get_all_tasks() list~Task~
        +get_tasks_due(day) list~Task~
        +filter_tasks(pet_name, completed, day) list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task) None
        +get_tasks_due(day) list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str frequency
        +time preferred_time
        +date last_completed
        +str pet_name
        +date due_date
        +update(details) None
        +mark_complete(day) None
        +is_due(day) bool
        +is_complete() bool
        +next_occurrence(day) Task
        +priority_rank() int
    }

    class Scheduler {
        +Owner owner
        +date plan_date
        +list~dict~ planned_items
        +list~dict~ skipped_items
        +generate_plan(day) list~dict~
        +mark_task_complete(task, day) Task
        +sort_tasks(tasks) list~Task~
        +sort_by_time(tasks) list~Task~
        +fit_tasks(tasks) tuple
        +assign_times(tasks) tuple
        +detect_conflicts() list~str~
        +total_minutes() int
        +explain_plan() str
        +display_plan() str
        -_earliest_free_start(earliest, duration, busy_periods) int
        -_conflict_warning(first, second) str
        -_label(task) str
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : needs
    Scheduler "1" --> "1" Owner : plans for
    Scheduler ..> Task : sorts, schedules and completes
    Scheduler ..> Pet : adds next occurrence to
    Task ..> Task : next_occurrence creates
